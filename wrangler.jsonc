{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animeta",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "animeta",
      "database_id": "08e8bd00-d8e3-4098-a378-f062d18feb47"
    }
  ],
  // Uploaded video. D1 cannot hold video, so the bytes go here and D1 keeps only
  // the metadata row.
  //
  // The bucket is deliberately private: uploads are served through the Worker so
  // the per-title access rule is checked on every request. A public bucket would
  // hand out a direct URL that bypasses it.
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "animeta"
    }
  ],
  "routes": [
    {
      "pattern": "animeta.studykittools.com",
      "custom_domain": true
    }
  ],
  // Non-secret configuration. Change these when moving to a production domain.
  "vars": {
    // Always resolves to the admin role. Comma-separated for multiple owners.
    "OWNER_EMAIL": "justinezantoz01@gmail.com, personaljustine21@gmail.com",
    // Public base URL, used to build password-reset links.
    "APP_URL": "https://animeta.studykittools.com",
    // Sender identity for reset emails. Swap for your own domain's address later,
    // e.g. "Animeta <noreply@yourdomain.com>" once Resend verifies it.
    "MAIL_FROM": "Animeta <noreply@onboarding@resend.dev>"
  },
  "observability": {
    "enabled": true
  }
}